# ~/.ssh/config.
#
# Was one sops secret holding the whole file, symlinked over ~/.ssh/config. That
# made every host secret whether it needed to be, and left no way to say "this
# one is reached differently from the laptop" short of keeping two encrypted
# copies of everything.
#
# It is assembled here instead, from three layers, in this order:
#
#   1. public,  this machine   my.ssh.extraConfig
#   2. private, everywhere     Include /run/secrets/ssh_hosts
#   3. public,  everywhere     files/ssh/hosts.conf
#
# The order is the whole point. ssh takes the *first* value it obtains for a
# keyword and merges in whatever later blocks add, so a machine-specific block
# up top overrides the shared one below it per keyword rather than replacing it:
#
#     Host vibevm            <- layer 1, on the laptop
#         ProxyJump desktop
#     Host vibevm            <- layer 3, everywhere
#         HostName 192.168.100.68
#         User alan
#
# resolves to that address, that user, through the desktop. Restating the
# address on the laptop would be the thing to get wrong later.
#
# Layer 2 is a sops secret, so the hosts in it never reach the nix store. There
# is deliberately no private counterpart to layer 1: the hidden hosts are
# reached the same way from everywhere, and a per-machine encrypted file would
# be a second place to keep them in step for no one's benefit.
#
# A missing Include is not an error to ssh -- checked against OpenSSH 10.4 --
# so nothing breaks in the window before sops-nix has populated /run/secrets.
# The lines are still emitted only when the secret is declared, so the file
# never points at something that was never going to exist.
{
  lib,
  osConfig,
  ...
}:
let
  cfg = osConfig.my.ssh;
  secrets = osConfig.sops.secrets;

  # Blank layers leave no heading behind: an empty "this machine" section in a
  # generated file reads like something failed to render.
  section =
    title: body:
    lib.optionalString (body != "") ''

      # ---- ${title} ----
      ${body}
    '';
in
{
  # ssh insists this is not writable by anyone but its owner, and accepts a
  # root-owned file -- which is what a home-manager symlink into the store is.
  home.file.".ssh/config".text =
    ''
      # Generated by home/ssh.nix. Edit that, or files/ssh/hosts.conf, not this.
      #
      # Ordered most-specific first: ssh keeps the first value it obtains for
      # each keyword, so what is only true from this machine has to come before
      # what is true from all of them.
      IdentitiesOnly yes
    ''
    + section "this machine" cfg.extraConfig
    + section "everywhere, private" (
      lib.optionalString cfg.privateHosts ''
        # `Host *` is load-bearing. Include is an ordinary keyword, not a
        # section break, so on its own it lands inside whatever `Host` block
        # the machine section left open and ssh reads the file without applying
        # any of it. Reopening the match costs no precedence -- the machine
        # section is still first in the file. Checked against OpenSSH 10.4.
        Host *
        Include ${secrets.ssh_hosts.path}''
    )
    + section "everywhere" (builtins.readFile ./files/ssh/hosts.conf);
}
